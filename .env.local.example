# =====================================================================
#  Moov'Up CRM : variables d'environnement
#  En local : copiez ce fichier en « .env.local ».
#  En ligne : Vercel → Settings → Environment Variables (mêmes noms).
#  Guide pas à pas : docs/MISE-EN-LIGNE.md · vérification : /parametres/systeme
# =====================================================================

# --- Supabase (obligatoire) : Project Settings → API ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta-cle-anon-publique
# Clé « service_role » : SECRÈTE, serveur uniquement (réservation en ligne, avis,
# rappels et sauvegardes automatiques). Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Tâches planifiées (obligatoire) ---
# Longue phrase aléatoire (32 caractères ou plus). Protège /api/cron et /api/backup ;
# Vercel Cron l'envoie automatiquement.
CRON_SECRET=

# --- Adresse publique du site (obligatoire en ligne) ---
NEXT_PUBLIC_SITE_URL=https://crm.moovup.ma

# --- WhatsApp Business Cloud API (facultatif ; sinon liens wa.me) ---
# Token permanent d'un utilisateur système Meta. Le « Phone number ID » se saisit
# dans le CRM : Paramètres → WhatsApp.
WHATSAPP_TOKEN=

# --- Paiement en ligne CMI (facultatif) ---
CMI_CLIENT_ID=
CMI_STORE_KEY=
# Adresse de la passerelle fournie par le CMI (test puis production)
CMI_GATEWAY_URL=

# --- Démo (local uniquement, JAMAIS en ligne) ---
# NEXT_PUBLIC_DEMO=1
